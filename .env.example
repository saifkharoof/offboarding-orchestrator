# Copy to .env and fill in. .env is git-ignored.

# Where run state, the step trace, the side-effect ledger and the LangGraph
# checkpoints are stored. Defaults to ./offboarding.db when unset.
OFFBOARDING_DB_PATH=./offboarding.db

# LLM provider: "fake" (default, deterministic, no network) or "gemini".
# The test suite always uses "fake" and never needs a key.
OFFBOARDING_LLM_PROVIDER=fake

# Only required when OFFBOARDING_LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Fault injection for the mocked IAM tool -- makes revoke_access fail
# transiently this many times before succeeding. Unset or 0 = never fails.
# Lets you demo the retry path without touching code: see README "Demo".
OFFBOARDING_IAM_FAIL_TIMES=0
